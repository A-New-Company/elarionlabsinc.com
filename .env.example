# ── Production waitlist storage (Upstash Redis / Vercel KV) ──────────────
# When these are set, the waitlist writes to Upstash. When they are absent
# (e.g. local dev), it falls back to a local .data/waitlist.json file.
#
# Get them by adding the "Upstash for Redis" integration in the Vercel
# dashboard (Storage tab) — Vercel injects them automatically on deploy.
# For local testing against a real Upstash DB, copy this file to .env.local
# and fill in the REST URL + token from the Upstash console.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Either the KV_* names above (Vercel KV) or the UPSTASH_* names below work:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional: transactional email (not enabled yet) ─────────────────────
# RESEND_API_KEY=
