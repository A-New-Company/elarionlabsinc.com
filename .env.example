# ── Waitlist storage backend ────────────────────────────────────────────
# The store picks a backend by which vars are set (lib/store.ts):
#   1. Google Sheet  → SHEETS_WEBHOOK_URL set
#   2. Upstash Redis → KV_/UPSTASH_ vars set
#   3. File (dev)     → none set → .data/waitlist.json

# Option 1: Google Sheet via Apps Script web app (see doc/GOOGLE_SHEET_SETUP.md)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Option 2: Upstash Redis / Vercel KV
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# ── Optional: transactional email (not enabled yet) ─────────────────────
# RESEND_API_KEY=
